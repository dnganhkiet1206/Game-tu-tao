; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Hòn Gió"
config/description="Vertical slice demo: open-world life sim on a small Vietnamese island. Mobile-first (Android/iOS)."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Mobile")
run/max_fps=60
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout=""
general/text_to_speech=false

[autoload]

Events="*res://src/core/events.gd"
Game="*res://src/core/game_state.gd"
Audio="*res://src/core/audio_manager.gd"
DayNight="*res://src/core/day_night.gd"

[debug]

gdscript/warnings/untyped_declaration=0
gdscript/warnings/unused_parameter=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=4
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

